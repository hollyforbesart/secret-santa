{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-secret-santa",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-santa",
      "database_id": "241209e4-0929-4279-8bcd-2131497d00a4"
    }
  ],
  // Checks every 15 minutes whether it's time to draw names.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
